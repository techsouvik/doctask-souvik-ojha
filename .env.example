# App Configuration
APP_NAME="DocuMesh Engine"
DEBUG=false

# Database & Storage
# Local SQLite fallback: sqlite+aiosqlite:///./documesh.db
# PostgreSQL: postgresql+asyncpg://documesh:documesh_password@localhost:5432/documesh_db
DATABASE_URL="postgresql+asyncpg://documesh:documesh_password@localhost:5432/documesh_db"
REDIS_URL="redis://localhost:6379/0"

# LLM Providers
OPENAI_API_KEY=""
ANTHROPIC_API_KEY=""
TAVILY_API_KEY=""

# Multi-Tenancy
DEFAULT_TENANT_ID="tenant_default"
DEFAULT_PROJECT_ID="proj_greenfield_tech_park"
